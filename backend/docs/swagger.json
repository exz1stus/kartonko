        "/image/upload/batch": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Uploads multiple images with metadata in a single request (requires authentication)\n!!Swagger to openapi conversion doesn't support file arrays",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "images"
                ],
                "summary": "Uploads multiple images in batch",
                "parameters": [
                    {
                        "type": "string",
                        "example": "{\"data\": [{\"name\": \"img1\", \"tags\": [\"tag1\"]}, {\"name\": \"img2\", \"tags\": [\"tag2\"]}], \"common_tags\": [\"common\"]}",
                        "description": "Batch metadata (JSON)",
                        "name": "metadata",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Files to upload",
                        "name": "files",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",

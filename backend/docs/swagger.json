    "definitions": {
        "AuthRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "EntryResponse": {
            "type": "object",
            "required": [
                "action",
                "affected_obj_id",
                "created_at",
                "data",
                "id",
                "object_type",
                "user_id"
            ],
            "properties": {
                "action": {
                    "type": "string"
                },
                "affected_obj_id": {
                    "type": "integer"
                },
                "created_at": {
                    "type": "string"
                },
                "data": {
                    "type": "object"
                },
                "id": {
                    "type": "integer"
                },
                "object_type": {
                    "type": "string"
                },
                "user_id": {
                    "type": "integer"
                }
            }
        },
        "ErrorResponse": {
            "type": "object",
            "required": [
                "error"
            ],
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "ImageError": {
            "type": "object",
            "required": [
                "error",
                "name"
            ],
            "properties": {
                "error": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "ImageMetadata": {
            "type": "object",
            "required": [
                "filename",
                "format",
                "hash",
                "height",
                "id",
                "tags",
                "uploaded_at",
                "user_id",
                "width"
            ],
            "properties": {
                "filename": {
                    "type": "string"
                },
                "format": {
